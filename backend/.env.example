DATABASE_URL="postgresql://geomaple:geomaple123@localhost:5432/geomaple"
SHADOW_DATABASE_URL="postgresql://geomaple:geomaple123@localhost:5432/geomaple_shadow"
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=3001

# Origens permitidas para CORS, separadas por vírgula (sem espaço). Em dev, a porta
# padrão do Vite; em produção, o domínio público do serviço `frontend` no Railway.
CORS_ORIGIN=http://localhost:5183

# Município atendido por esta implantação (nada no código deve ficar fixo em um município —
# para atender outra prefeitura, basta trocar estas variáveis e rodar novo seed/deploy)
MUNICIPIO_NOME="Ouro Preto"
MUNICIPIO_UF=MG
MUNICIPIO_IBGE=3146107
MUNICIPIO_CENTRO_LAT=-20.3855
MUNICIPIO_CENTRO_LNG=-43.5035
MUNICIPIO_CENTRO_ZOOM=17

# SINTER/CADURB (Receita Federal) — CONFIDENCIAL, nunca commitar valores reais.
# Credenciais e ambiente fornecidos pelo time do CADURB para o município acima.
SINTER_CLIENT_ID=
SINTER_CLIENT_SECRET=
SINTER_BASE_URL=https://hom-lb-sinter2-cadurb.np.estaleiro.serpro.gov.br
