# VITE_API_URL é embutida no bundle em BUILD TIME pelo Vite — não é lida em runtime.
# No Railway, configure como variável do serviço `frontend` ANTES do primeiro build,
# usando a reference variable do serviço `backend`:
#
#   VITE_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
#
# Se o domínio do backend mudar, é necessário um novo BUILD do frontend (redeploy sem
# rebuild não é suficiente, porque o valor já está compilado no JS gerado).
VITE_API_URL=https://SEU-BACKEND.up.railway.app
